# Python bytecode caches (Python itself is against repo convention — see CLAUDE.md "Known process debt" —
# but any stray __pycache__ left behind by running existing scripts should never be tracked)
__pycache__/
*.pyc

# Ephemeral tool output (not repo content)
.playwright-mcp/

# OS cruft
.DS_Store

# HackerRank session credentials (cookie/CSRF) -- token-level secrets, never committed.
# Physically separate from .hackerrank/ (tracked scripts): .hackerrank/hr_submit.sh and
# hr_poll.sh source this at runtime; see hackerrank_api_notes.md.
.env.hackerrank

# Compiled pre-commit checker (rebuilt on demand by .githooks/pre-commit)
.githooks/.precommit_check_bin

# Nested agent worktree checkouts (each is its own git working copy inside
# .claude/worktrees/ -- must never be tracked/added to the main repo's tree)
.claude/worktrees/

# jaiora plugin's own internal state -- a separate automated system running
# against this repo (see .logs/_meta/ audit note); its bookkeeping is not
# this repo's process bookkeeping and must not collide with .logs/euler*/
.claude/.jaiora-hashes
.claude/.jaiora-version
.claude/settings.local.json

# NOTE: .claude/rules/ was PREVIOUSLY gitignored here (grouped with the jaiora plugin's own
# internal cache state above by mistake). Un-ignored 2026-07-18
# (.logs/_meta/step-claude-rules-git-tracking.md): unlike .jaiora-hashes/.jaiora-version, these
# are hand-authored process rules (round-economics.md, verification-ladder.md,
# hypothesis-reframing.md, etc.) that CLAUDE.md itself references and depends on -- not
# regenerable plugin cache. Existed ONLY on local disk with no git history, no Time Machine, no
# other copy found anywhere -- a single-disk-failure risk for months of accumulated process
# knowledge. Now tracked like any other repo file.
.logs/apply-*.log
.logs/tool-calls.log

